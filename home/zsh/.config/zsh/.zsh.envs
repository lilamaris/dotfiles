# Environment variables

typeset -U path PATH

path_prepend() {
  [[ -d "$1" ]] && path=("$1" "$path[@]")
}

exec_command () {
  command -v "$1" >/dev/null 2>&1 &&
    "$@"
}

eval_command () {
  command -v "$1" >/dev/null 2>&1 &&
    eval "$("$@")"
}

if command -v nvim >/dev/null; then
  export EDITOR=nvim
elif command -v vim >/dev/null; then
  export EDITOR=vim
else
  export EDITOR=vi
fi

export LS_COLORS='di=30;46:ln=35:so=32:pi=32:ex=31:bd=32:cd=32:su=31:sg=31:tw=30;46:ow=30;46'

# zsh
export HISTFILE="$XDG_CACHE_HOME/.zsh_history"
export SAVEHIST=50000

# npm
export NPM_CONFIG_INIT_AUTHOR_NAME="lilamaris"
export NPM_CONFIG_INIT_AUTHOR_EMAIL="lilamaris.dev@gmail.com"
export NPM_CONFIG_INIT_AUTHOR_URL="https://blog.lilamaris.kr"
export NPM_CONFIG_INIT_LICENSE="MIT"

path_prepend "$HOME/.local/bin"
path_prepend "$HOME/bin"

# Optional runtime
source "$ZDOTDIR/opts/.zsh.interactive"
source "$ZDOTDIR/opts/.zsh.nvm"
source "$ZDOTDIR/opts/.zsh.pyenv"
source "$ZDOTDIR/opts/.zsh.pnpm"

unset -f path_prepend exec_command eval_command;
