# Reuse a fresh completion dump; refresh it at most once every 2 hours.
autoload -Uz compinit
typeset -r zsh_compdump_path="$XDG_CACHE_HOME/zsh/.zcompdump"
mkdir -p "${zsh_compdump_path:h}"
if [[ -n "$zsh_compdump_path"(#qNmh-2) ]]; then
  compinit -C -d "$zsh_compdump_path"
else
  compinit -d "$zsh_compdump_path"
fi

typeset -r zsh_plugin_home="/usr/share/zsh/plugins"
typeset -ra zsh_plugins=(
  "zsh-autosuggestions/zsh-autosuggestions"
  "zsh-syntax-highlighting/zsh-syntax-highlighting"
)

for zsh_plugin in "${zsh_plugins[@]}"; do
  zsh_plugin_path="${zsh_plugin_home}/${zsh_plugin%/}.zsh"

  if [[ -r "$zsh_plugin_path" ]]; then
    source "$zsh_plugin_path"
  fi
done

unset zsh_plugin zsh_plugin_path
