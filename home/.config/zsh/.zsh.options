# Zsh Options

# cd by typing directory name if it's not a command
setopt auto_cd

# automatically list choices on ambiguous completion
setopt auto_list

# automatically use menu completion
setopt auto_menu

# move cursor to end if word had one match
setopt always_to_end

# expire duplicate entries first when trimming history
setopt hist_expire_dups_first

# don't display duplicate entries in history
setopt hist_find_no_dups

# ignore commands starting with space
setopt hist_ignore_space

# remove older duplicate entries from history
setopt hist_ignore_all_dups

# remove superfluous blanks from history items
setopt hist_reduce_blanks

# don't save duplicate entries in history
setopt hist_save_no_dups

# don't execute immediately upon history expansion
setopt hist_verify

# save history entries as soon as they are entered
setopt inc_append_history

# share history between different instances
setopt share_history

# autocorrect commands
setopt correct_all

# allow comments in interactive shells
setopt interactive_comments

# unbind Ctrl + r for fwd-i-search
bindkey -r "^S"
